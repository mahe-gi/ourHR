# Environment Variables Template for ourHR

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ourhr_db
DB_USERNAME=postgres
DB_PASSWORD=replace_with_secure_password
DB_SCHEMA=public

# Multi-Tenancy
TENANT_ISOLATION_STRATEGY=DISCRIMINATOR

# Security & JWT Configuration
JWT_SECRET=replace_with_at_least_256_bit_random_secret_key_base64
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# S3-Compatible Object Storage Adapter (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=ourhr-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE_ACCESS=true

# Logging & Monitoring
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_FORMAT=JSON
